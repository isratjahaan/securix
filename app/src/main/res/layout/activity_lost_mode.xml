<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_black"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/securix_logo"
        android:contentDescription="Securix Shield" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="DEVICE LOCKED"
        android:textColor="@color/danger_red"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/tvLostNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="THIS PHONE IS REPORTED LOST OR STOLEN.\nALL ACTIONS ARE MONITORED &amp; GPS TRACKED."
        android:textColor="@color/white"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvCustomLostMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/badge_background"
        android:padding="16dp"
        android:gravity="center"
        android:text="Please return this phone to the owner. Call emergency contact below."
        android:textColor="@color/accent_cyan"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCallOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="CALL OWNER (+18005550199)"
        android:textColor="@color/secondary_black"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_emerald"
        app:cornerRadius="10dp" />

    <!-- Owner Unlock PIN Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="OWNER PIN UNLOCK"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:letterSpacing="0.1" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilUnlockPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:boxStrokeColor="@color/primary_emerald"
        app:hintTextColor="@color/primary_emerald"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/primary_emerald">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUnlockPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_navy"
            android:hint="Enter 4-Digit Security PIN"
            android:inputType="numberPassword"
            android:maxLength="8"
            android:textColor="@color/white"
            android:textColorHint="@color/text_muted" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitUnlockPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="UNLOCK DEVICE"
        android:textColor="@color/white"
        app:backgroundTint="@color/card_navy"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        app:cornerRadius="8dp" />

</LinearLayout>
