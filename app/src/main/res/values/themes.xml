<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Securix" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_emerald</item>
        <item name="colorPrimaryVariant">@color/accent_cyan</item>
        <item name="colorOnPrimary">@color/secondary_black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSecondaryVariant">@color/primary_emerald</item>
        <item name="colorOnSecondary">@color/secondary_black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/secondary_black</item>
        <item name="android:navigationBarColor">@color/secondary_black</item>
        <item name="android:windowBackground">@color/secondary_black</item>
    </style>

    <style name="Theme.Securix.Fullscreen" parent="Theme.Securix">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
